# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# SECRET. Bypasses Row Level Security, so it must stay on the server.
# Never rename this with a NEXT_PUBLIC_ prefix — that would ship it to
# every visitor's browser and hand them full write access to your data.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
